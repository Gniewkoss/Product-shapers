{
  "name": "product-shapers-consulting",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:cms": "npm run dev --prefix cms",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev --prefix cms\"",
    "build": "tsc -b && vite build",
    "build:netlify": "node scripts/generate-netlify-redirects.mjs && node scripts/fetch-cms-data.mjs && npm run build",
    "preview": "vite preview",
    "figma:pull-szkolenia-benefit-icon": "node scripts/fetch-figma-node-png.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.6.2",
    "vite": "^5.4.11"
  }
}
