# DB: omit DATABASE_URI (or set DATABASE_ADAPTER=sqlite) to use SQLite at cms/payload.local.db
# Optional override: SQLITE_URL=file:/absolute/path/to/db
# Postgres: docker compose up -d in cms/, then set DATABASE_URI (and do not force sqlite):
# DATABASE_URI=postgresql://postgres:postgres@127.0.0.1:5433/payload
PAYLOAD_SECRET=replace-with-random-32-chars-minimum
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:5173
# Produkcja: domena Netlify + opcjonalnie preview, np. https://twoja-app.netlify.app,https://deploy-preview-123--twoja-app.netlify.app
# FRONTEND_ORIGINS=https://twojadomena.pl
# Push schematu w dev: bez TTY push jest pomijany (żeby /admin nie wisiał). Wymuszanie:
# PAYLOAD_DATABASE_PUSH=true   — zawsze push (potrzebny interaktywny terminal przy ostrzeżeniach Drizzle)
# PAYLOAD_DATABASE_PUSH=false  — nigdy push (np. po jednorazowym zsynchronizowaniu schematu ręcznie)
# Optional: POST to this CMS route after publish (requires secret)
REVALIDATE_SECRET=9f3c2d8a1b7e4c6d9f0a3b2c1d4e5f67890abcdeffedcba9876543210abcdef

# REST import script (`npm run import:api`): use either API key or admin login
# Admin → Users → your user → API Key (the script sends it as `users API-Key <token>`)
PAYLOAD_API_TOKEN=
# Or set email + password (no API key needed)
PAYLOAD_ADMIN_EMAIL=
PAYLOAD_ADMIN_PASSWORD=
# Optional overrides
PAYLOAD_BASE_URL=http://localhost:3000
PAYLOAD_IMPORT_FILE=