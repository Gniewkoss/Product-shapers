# Skopiuj na host produkcyjny jako cms/.env (nie commituj).
# Witryna B (Netlify): Payload — adres widoczny użytkownikowi w przeglądarce to witryna A (marketing), nie ten backend.

DATABASE_URI=postgresql://user:pass@host:5432/payload
PAYLOAD_SECRET=min-32-znakow-losowych

# Dokładnie adres witryny A z paska przeglądarki (bez końcowego /):
PAYLOAD_PUBLIC_SERVER_URL=https://twoja-strona.netlify.app

# Ta sama domena (+ opcjonalnie deploy-preview Netlify witryny A, po przecinku):
FRONTEND_ORIGINS=https://twoja-strona.netlify.app

# Pierwsza instalacja: ustaw DATABASE_URI + sekrety + URL powyżej, potem raz lokalnie:
#   npm run db:bootstrap --prefix cms   (schema Drizzle + seed z cms/src/seed/index.ts)
# Na witrynie CMS (B) po udanym bootstrapie ustaw false, żeby push nie uruchamiał się przy każdym restarcie.
PAYLOAD_DATABASE_PUSH=true

# --- Opcjonalnie: S3-compatible (AWS S3, Cloudflare R2) — zalecane na Netlify (ulotny dysk) ---
# Gdy S3_BUCKET + klucze są ustawione, Payload używa @payloadcms/storage-s3 dla kolekcji "media".
# S3_BUCKET=my-bucket
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1
# R2 / custom endpoint (np. Cloudflare R2):
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=true
