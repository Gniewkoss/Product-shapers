# Skopiuj jako cms/.env na hoście CMS (nie commituj), np. Render Web lub lokalnie przy bootstrapie.

DATABASE_URI=postgresql://user:pass@host:5432/payload
# Bootstrap z laptopa na zewnętrzny Postgres Render: dopisz ?sslmode=require (albo &sslmode=require jeśli URI już ma parametry).
PAYLOAD_SECRET=min-32-znakow-losowych

# --- Kanoniczny URL tej instancji Payload (REST + panel `/admin`), bez końcowego /
# Zalecane na Renderze, gdy panel otwierasz na *.onrender.com:
# PAYLOAD_SERVER_URL=https://twoj-serwis.onrender.com

# Adres witryny marketingowej (Netlify / własna domena), bez końcowego /:
PAYLOAD_PUBLIC_SERVER_URL=https://twoja-strona.netlify.app

# Jeśli `/admin` jest wyświetlane POD adresem marketingowym (proxy 200 na Render),
# a Payload nadal ma PAYLOAD_PUBLIC_SERVER_URL = marketing — ustaw:
# PAYLOAD_USE_MARKETING_SERVER_URL=true
# (wtedy serverURL = marketing; domyślnie, gdy Render ma RENDER_EXTERNAL_URL i URL się różni,
#  Payload bierze URL Render = panel na onrender.com działa poprawnie.)

# Ta sama domena marketingowa (+ opcjonalnie deploy-preview Netlify, po przecinku):
FRONTEND_ORIGINS=https://twoja-strona.netlify.app

# Pierwsza instalacja: ustaw DATABASE_URI + sekrety + URL powyżej, potem raz:
#   npm run db:bootstrap --prefix cms   (lokalnie lub Render Shell w cms/)
# Po udanym bootstrapie na Renderze ustaw PAYLOAD_DATABASE_PUSH=false.
PAYLOAD_DATABASE_PUSH=true

# --- Opcjonalnie: S3-compatible (AWS S3, Cloudflare R2) ---
# Zalecane na Renderze bez Persistent Disk (dysk kontenera jest ulotny) lub gdy chcesz obiekty poza VM.
# Gdy S3_BUCKET + klucze są ustawione, Payload używa @payloadcms/storage-s3 dla kolekcji "media".
# S3_BUCKET=my-bucket
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1
# R2 / custom endpoint (np. Cloudflare R2):
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=true
